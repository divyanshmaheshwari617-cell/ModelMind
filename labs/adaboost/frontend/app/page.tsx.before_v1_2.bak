"use client";
import {useEffect,useMemo,useRef,useState} from 'react';
import Papa from 'papaparse';
import {BrainCircuit,UploadCloud,Play,Pause,RotateCcw,ChevronRight,Activity,Layers3,ChartNoAxesCombined,Download,Info,Sparkles,Database,Settings2} from 'lucide-react';
import {getDataset,trainModel} from '@/lib/api';
import type {DataRow,DataSet,Task,TrainConfig,TrainResult} from '@/lib/types';
import {LearningCurve,WeightChart,ImportanceChart,SurfaceChart,pretty} from '@/components/charts';
const collections=[{id:'moons',name:'Two Moons',desc:'Noisy curves • classification'},{id:'complex-classification',name:'Mixed Classification',desc:'Missing data • categories'},{id:'nonlinear-regression',name:'Nonlinear Regression',desc:'Sinusoidal • interactions'},{id:'mixed-regression',name:'Mixed Regression',desc:'Friedman • categorical'}];
const cap=(s:string)=>s.replaceAll('_',' ').replace(/\b\w/g,x=>x.toUpperCase());
const missing=(value:unknown)=>value===null||value===undefined||String(value).trim()==='';
function numericColumns(rows:DataRow[],columns:string[]){return columns.filter(c=>{const values=rows.map(r=>r[c]).filter(v=>!missing(v));return values.length>0&&values.filter(v=>typeof v==='number'?Number.isFinite(v):String(v).trim()!==''&&Number.isFinite(Number(v))).length/values.length>=.95})}
function DatasetInsights({data,target,features,task}:{data:DataSet;target:string;features:string[];task:Task}){
 const summary=useMemo(()=>{const nums=numericColumns(data.rows,data.columns.filter(c=>c!==target));const missingByColumn=data.columns.map(c=>({name:c,count:data.rows.filter(r=>missing(r[c])).length})).filter(v=>v.count>0).sort((a,b)=>b.count-a.count);const targetValues=data.rows.map(r=>r[target]).filter(v=>!missing(v));const counts=new Map<string,number>();targetValues.forEach(v=>counts.set(String(v),(counts.get(String(v))||0)+1));return{nums,missingByColumn,missingTotal:missingByColumn.reduce((a,b)=>a+b.count,0),targetMissing:data.rows.length-targetValues.length,classes:[...counts].sort((a,b)=>b[1]-a[1]),distinct:counts.size}},[data,target]);
 return <div className="insights"><div className="insights-grid"><div><b>{data.rows.length}</b><small>Rows</small></div><div><b>{summary.nums.length}</b><small>Numeric columns</small></div><div><b>{data.columns.length-summary.nums.length-1}</b><small>Other predictors</small></div><div><b>{summary.missingTotal}</b><small>Missing cells</small></div></div><p className="small"><b>Dataset health:</b> {summary.targetMissing} missing targets; {summary.distinct} distinct nonempty target values; {features.length} selected inputs. Missing inputs are imputed using training-only statistics.</p>{summary.missingByColumn.length>0&&<div className="insights-rows">{summary.missingByColumn.slice(0,7).map(x=><div key={x.name}><span>{x.name}</span><div className="missing-track"><div style={{width:`${100*x.count/data.rows.length}%`}}/></div><span>{(100*x.count/data.rows.length).toFixed(1)}%</span></div>)}</div>}{task==='classification'&&<div className="insights-classes"><b>Target distribution</b>{summary.classes.slice(0,10).map(([label,count])=><div key={label}><span>{label}</span><strong>{count} ({(100*count/Math.max(1,data.rows.length-summary.targetMissing)).toFixed(1)}%)</strong></div>)}</div>}{task==='regression'&&<p className="small">Regression target should be numeric and contain at least three distinct valid values.</p>}<details><summary>Preview uploaded rows</summary><div className="tablewrap"><table><thead><tr>{data.columns.slice(0,10).map(c=><th key={c}>{c}</th>)}</tr></thead><tbody>{data.rows.slice(0,6).map((r,i)=><tr key={i}>{data.columns.slice(0,10).map(c=><td key={c}>{missing(r[c])?'—':String(r[c])}</td>)}</tr>)}</tbody></table></div></details></div>
}
function TheoryStudio({task,stage,result}:{task:Task;stage:number;result:TrainResult|null}){
 const [level,setLevel]=useState<'basic'|'intermediate'|'advanced'>('basic');const current=result?.stages[stage];return <div className="theory"><div className="tabs">{(['basic','intermediate','advanced'] as const).map(v=><button key={v} className={v===level?'current':''} onClick={()=>setLevel(v)}>{cap(v)}</button>)}</div>{level==='basic'?<><h3>Why AdaBoost works</h3><p>A weak learner (typically a small decision tree) makes a simple prediction. AdaBoost trains the next learner using a new weighting of training examples so the ensemble can correct earlier mistakes.</p><p>Imagine five teachers solving the same question: we give more attention to questions the first teacher missed, then combine what they learned. AdaBoost does this automatically using a sequence of models.</p><p><b>{task==='classification'?'Classification':'Regression'}:</b> {task==='classification'?'The final result combines weighted classification decisions. A low weighted classification error usually means a learner receives more influence.':'AdaBoost.R2 resamples examples using error-dependent weights and combines regression estimates using a weighted median.'}</p></>:level==='intermediate'?<><h3>Understand the training controls</h3><p><b>n_estimators:</b> upper limit on boosting rounds. More rounds may improve fit, but can increase training time or overfitting.</p><p><b>learning_rate:</b> scales each learner’s influence. Try smaller rates with more estimators and compare train/test curves.</p><p><b>max_depth:</b> complexity of each decision tree. Depth 1 creates decision stumps; deeper trees learn feature interactions but can overfit.</p><p><b>min_samples_leaf:</b> minimum observations in each leaf; larger values generally smooth boundaries.</p><p><b>Train vs test:</b> a large performance gap can be a warning sign of overfitting. Classification uses accuracy and macro-F1; regression uses R² and error metrics.</p></>:<><h3>Mathematics and implementation details</h3><p><b>AdaBoost binary classification intuition:</b> weighted error εₜ = Σᵢ wᵢ·I(yᵢ ≠ hₜ(xᵢ)) / Σᵢ wᵢ.</p><div className="formula">αₜ = learning_rate × ln((1 − εₜ) / εₜ)</div><p>For multiclass SAMME, the learner weight includes ln(K − 1). Weighted errors and estimator weights depend on the implementation and class count.</p><p>Weights shift towards examples the learner misclassifies, and the final classifier combines the weak learners’ weighted votes.</p><p><b>AdaBoost.R2:</b> normalizes individual prediction errors, assigns loss-based sample weights, and uses the weighted median of the regressors. The SAMME equation above is not its regression formula.</p><p><b>Leakage prevention:</b> the split must happen before fitting imputers, encoders, and the estimator. The plot fixes unplotted features at training-set medians or modes; it is a slice, not a complete picture of a high-dimensional model.</p></>}{current&&<div className="notice">At round {current.round}, learner error = {pretty(current.error)}, learner weight = {pretty(current.weight)}. These are diagnostics; inspect test performance across rounds before drawing conclusions.</div>}</div>}

function Card({title,desc,children,extra}:{title:string;desc?:string;children:React.ReactNode;extra?:React.ReactNode}){return <section className="card"><div className="cardhead"><div><h2>{title}</h2>{desc&&<p className="small">{desc}</p>}</div>{extra}</div>{children}</section>}
function NumberControl({name,value,min,max,step=1,onChange}:{name:string;value:number;min:number;max:number;step?:number;onChange:(x:number)=>void}){return <label className="control"><span>{name}<b>{value}</b></span><input type="range" min={min} max={max} step={step} value={value} onChange={e=>onChange(Number(e.target.value))}/></label>}
function Metric({name,value}:{name:string;value:number|null|undefined}){return <div className="metric"><span>{cap(name)}</span><strong>{pretty(value)}</strong></div>}
export default function Page(){
 const [data,setData]=useState<DataSet|null>(null);const[datasetId,setDatasetId]=useState('moons');const[task,setTask]=useState<Task>('classification');const[target,setTarget]=useState('target');const[features,setFeatures]=useState<string[]>([]);const[plotAxes,setPlotAxes]=useState<string[]>([]);
 const[estimators,setEstimators]=useState(60);const[lr,setLr]=useState(.8);const[depth,setDepth]=useState(1);const[leaf,setLeaf]=useState(1);const[loss,setLoss]=useState<'linear'|'square'|'exponential'>('linear');const[testSize,setTestSize]=useState(.25);
 const[result,setResult]=useState<TrainResult|null>(null);const[loading,setLoading]=useState(false);const[loadData,setLoadData]=useState(false);const[err,setErr]=useState('');const[stage,setStage]=useState(0);const[playing,setPlaying]=useState(false);const[threeD,setThreeD]=useState(false);const[tab,setTab]=useState<'visualize'|'metrics'|'explain'|'predictions'>('visualize');
 const fileRef=useRef<HTMLInputElement>(null);
 async function fetchDataset(id:string){setLoadData(true);setErr('');try{const ds=await getDataset(id);setData(ds);setTask(ds.task);setTarget(ds.target);setFeatures(ds.features);setPlotAxes(numericColumns(ds.rows,ds.features).slice(0,2));setResult(null);setStage(0);setPlaying(false);setDatasetId(id)}catch(e){setErr(e instanceof Error?e.message:String(e))}finally{setLoadData(false)}}
 useEffect(()=>{void fetchDataset('moons')},[]);
 useEffect(()=>{if(!playing||!result)return;const t=setInterval(()=>setStage(s=>{if(s>=result.stages.length-1){setPlaying(false);return s}return s+1}),450);return()=>clearInterval(t)},[playing,result]);
 function handleFile(file?:File){if(!file)return;setErr('');Papa.parse<DataRow>(file,{header:true,skipEmptyLines:true,dynamicTyping:true,complete:r=>{const rows=(r.data||[]).filter(x=>Object.values(x).some(v=>v!==null&&v!==''));const columns=r.meta.fields||Object.keys(rows[0]||{});if(!rows.length||columns.length<2){setErr('CSV needs at least two columns and data rows');return}const tgt=columns.includes('target')?'target':columns[columns.length-1];const vals=rows.map(row=>row[tgt]).filter(v=>v!=null&&v!=='');const unique=new Set(vals.map(String));const kind:Task=unique.size<=12?'classification':'regression';setData({name:file.name,rows,columns,target:tgt,features:columns.filter(c=>c!==tgt),task:kind});setTarget(tgt);setFeatures(columns.filter(c=>c!==tgt));setPlotAxes(numericColumns(rows,columns.filter(c=>c!==tgt)).slice(0,2));setTask(kind);setResult(null);setDatasetId('uploaded');setStage(0)},error:e=>setErr(e.message)})}
 const usableFeatures=useMemo(()=>data?.columns.filter(c=>c!==target)||[],[data,target]);
 const numericFeatures=useMemo(()=>data?numericColumns(data.rows,features):[],[data,features]);
 async function run(){if(plotAxes.length===2&&plotAxes[0]===plotAxes[1]){setErr('Choose two different visualization axes');return}if(!data||features.length===0){setErr('Select a dataset and at least one feature');return}setLoading(true);setErr('');setPlaying(false);try{const input:TrainConfig={rows:data.rows,features,target,task,n_estimators:estimators,learning_rate:lr,max_depth:depth,min_samples_leaf:leaf,loss,test_size:testSize,random_state:42,compare_baseline:true,plot_features:plotAxes.length===2&&plotAxes.every(f=>numericFeatures.includes(f))?plotAxes:undefined};const res=await trainModel(input);setResult(res);setStage(res.stages.length-1);setTab('visualize')}catch(e){setErr(e instanceof Error?e.message:String(e))}finally{setLoading(false)}}
 function download(){if(!result)return;const blob=new Blob([JSON.stringify(result,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='modelmind-adaboost-report.json';a.click();URL.revokeObjectURL(url)}
 const active=result?.stages[stage];const focus=task==='classification'?'accuracy':'r2';
 return <div className="shell"><aside className="sidebar"><div className="brand"><div className="logo"><BrainCircuit size={22}/></div><div><strong>modelmind</strong><small>ADABOOST LAB</small></div></div><div className="sidetitle">LAB WORKSPACE</div><a href="#datasets"><Database size={17}/> Dataset studio</a><a href="#controls"><Settings2 size={17}/> Model controls</a><a href="#results"><Activity size={17}/> Training results</a><a href="#learning"><Layers3 size={17}/> Learning intuition</a><div className="sidebottom"><span className="statusdot"/> AdaBoost Classifier + Regressor<br/><small>Built for exploration · v1.0</small></div></aside><main className="content"><header className="topbar"><span>MODEL LABS <ChevronRight size={14}/> ENSEMBLE METHODS <ChevronRight size={14}/> <b>ADABOOST</b></span><span className="pill">Interactive Laboratory</span></header>
 <div className="hero"><div className="eyebrow"><Sparkles size={15}/> MODEL MIND / ENSEMBLE INTELLIGENCE</div><h1>Learn how <em>weak learners</em><br/>become a strong ensemble.</h1><p>Build AdaBoost models, inspect every boosting round, explore loss curves, and visualize how model confidence evolves.</p><div className="herochips"><span>Classification + Regression</span><span>Stage playback</span><span>2D / 3D</span><span>Train vs Test</span></div></div>
 {err&&<div role="alert" className="error">{err}</div>}
 <div className="two"><div id="datasets"><Card title="01 · Dataset Studio" desc="Built-in datasets or upload your own CSV" extra={<button className="ghost" onClick={()=>fileRef.current?.click()}><UploadCloud size={15}/> Upload CSV</button>}><input ref={fileRef} type="file" accept=".csv,text/csv" hidden onChange={e=>handleFile(e.target.files?.[0])}/><div className="datasetgrid">{collections.map(d=><button type="button" disabled={loadData} onClick={()=>void fetchDataset(d.id)} className={'datasetbtn '+(datasetId===d.id?'chosen':'')} key={d.id}><strong>{d.name}</strong><span>{d.desc}</span></button>)}</div>{data&&<><div className="datainfo"><span><b>{data.rows.length}</b> samples</span><span><b>{data.columns.length-1}</b> predictors available</span><span><b>{task}</b></span></div><div className="formrow"><label>Problem type<select value={task} onChange={e=>{setTask(e.target.value as Task);setResult(null)}}><option value="classification">Classification</option><option value="regression">Regression</option></select></label><label>Target column<select value={target} onChange={e=>{setTarget(e.target.value);setFeatures(data.columns.filter(c=>c!==e.target.value));setPlotAxes(numericColumns(data.rows,data.columns.filter(c=>c!==e.target.value)).slice(0,2));setResult(null)}}>{data.columns.map(c=><option value={c} key={c}>{c}</option>)}</select></label></div><div className="featurehead">Features selected <span>{features.length}/{usableFeatures.length}</span></div><div className="chips">{usableFeatures.map(f=><label className={'feature '+(features.includes(f)?'selected':'')} key={f}><input type="checkbox" checked={features.includes(f)} onChange={e=>setFeatures(old=>e.target.checked?[...old,f]:old.filter(x=>x!==f))}/>{f}</label>)}</div><DatasetInsights data={data} target={target} features={features} task={task}/></>}</Card></div>
 <div id="controls"><Card title="02 · Hyperparameter Studio" desc="Tune your weak learners and ensemble"><NumberControl name="Boosting rounds (n_estimators)" value={estimators} min={1} max={200} onChange={setEstimators}/><NumberControl name="Learning rate" value={lr} min={.05} max={2} step={.05} onChange={setLr}/><NumberControl name="Tree depth" value={depth} min={1} max={8} onChange={setDepth}/><NumberControl name="Minimum samples per leaf" value={leaf} min={1} max={30} onChange={setLeaf}/><NumberControl name="Test split" value={testSize} min={.1} max={.4} step={.05} onChange={setTestSize}/>{task==='regression'&&<label className="singlelabel">AdaBoost.R2 loss<select value={loss} onChange={e=>setLoss(e.target.value as typeof loss)}><option value="linear">Linear</option><option value="square">Square</option><option value="exponential">Exponential</option></select></label>}<div className="plot-selection"><h3>2D / 3D plot axes</h3><p className="small">Plot any two numeric features while training with all selected columns. Other features are fixed at training-set median or mode.</p>{numericFeatures.length>=2?<div className="formrow">{[0,1].map((index)=><label key={index}>{index===0?'Horizontal (X)':'Vertical (Y)'}<select value={plotAxes[index]&&numericFeatures.includes(plotAxes[index])?plotAxes[index]:''} onChange={e=>setPlotAxes(old=>{const next=[...old];next[index]=e.target.value;return next})}><option value="">Choose a feature</option>{numericFeatures.map(c=><option value={c} key={c}>{c}</option>)}</select></label>)}</div>:<div className="notice">Select at least two numeric input columns to visualize a surface.</div>}{plotAxes.length===2&&plotAxes[0]===plotAxes[1]&&<p className="small">Choose different columns for X and Y.</p>}</div><button className="primary full" disabled={loading||loadData||!data} onClick={()=>void run()}><Play size={17} fill="currentColor"/>{loading?'Training the ensemble…':'Train & Visualize AdaBoost'}<ChevronRight size={18}/></button></Card></div></div>
 <div id="results"><Card title="03 · Training Dashboard" desc={result?`${result.actual_estimators} weak learners fitted · ${result.rows.train} train / ${result.rows.test} test samples`:'Run a model to reveal training analytics'} extra={result&&<button className="ghost" onClick={download}><Download size={16}/> Report JSON</button>}>
 {!result?<div className="empty"><ChartNoAxesCombined size={45}/><h3>Ready when you are.</h3><p>Select features, adjust parameters and press “Train & Visualize AdaBoost.”</p></div>:<><div className="metricgrid"><Metric name={focus==='accuracy'?'test accuracy':'test r2'} value={result.metrics.test[focus]}/><Metric name={focus==='accuracy'?'train accuracy':'train r2'} value={result.metrics.train[focus]}/><Metric name={task==='classification'?'test f1 macro':'test rmse'} value={result.metrics.test[task==='classification'?'f1_macro':'rmse']}/><Metric name="weak learners" value={result.actual_estimators}/></div><div className="tabs">{(['visualize','metrics','explain','predictions'] as const).map(t=><button key={t} className={tab===t?'current':''} onClick={()=>setTab(t)}>{cap(t)}</button>)}</div>
 {tab==='visualize'&&<><div className="playbar"><span>Boosting round <b>{stage+1} / {result.stages.length}</b></span><div><button className="ghost iconbutton" aria-label="Reset" onClick={()=>{setPlaying(false);setStage(0)}}><RotateCcw size={16}/></button><button className="ghost iconbutton" aria-label={playing?'Pause':'Play'} onClick={()=>{if(stage===result.stages.length-1)setStage(0);setPlaying(!playing)}}>{playing?<Pause size={16}/>:<Play size={16}/>}</button></div><input aria-label="Round" type="range" min={0} max={result.stages.length-1} value={stage} onChange={e=>{setPlaying(false);setStage(Number(e.target.value))}}/></div><div className="two"><Card title="Learning performance" desc="Training vs testing by boosting round"><LearningCurve data={result.stages} active={stage} metric={focus}/></Card><Card title="Weak learner influence" desc="Estimator weights through the selected round"><WeightChart data={result.stages} active={stage}/></Card></div>{result.surface&&<Card title="Decision boundary / regression surface" desc="Plot two chosen numeric axes; other training features are held at representative values" extra={<div className="toggle"><button onClick={()=>setThreeD(false)} className={!threeD?'active':''}>2D</button><button onClick={()=>setThreeD(true)} className={threeD?'active':''}>3D</button></div>}><SurfaceChart surface={result.surface} task={result.task} classes={result.classes} threeD={threeD}/><p className="small">Surface represents the final full-feature model over the two chosen axes. Other features are fixed at training-set medians or modes; stage playback is separate.</p></Card>}{!result.surface&&<div className="notice"><Info size={17}/> Select at least two numeric predictors and two different plot axes to enable the 2D decision map and 3D surface.</div>}</>}
 {tab==='metrics'&&<div className="two"><Card title="Final train / test metrics"><table><thead><tr><th>Metric</th><th>Train</th><th>Test</th><th>Decision tree</th></tr></thead><tbody>{Object.keys(result.metrics.test).map(k=><tr key={k}><td>{cap(k)}</td><td>{pretty(result.metrics.train[k])}</td><td>{pretty(result.metrics.test[k])}</td><td>{pretty(result.metrics.baseline?.[k])}</td></tr>)}</tbody></table></Card><Card title="Feature importance" desc="Combined weighted importance across the ensemble"><ImportanceChart data={result.importance}/></Card>{result.confusion_matrix&&<Card title="Confusion matrix" desc={'Class order: '+result.classes.join(', ')}><table><tbody>{result.confusion_matrix.map((r,i)=><tr key={i}>{r.map((v,j)=><td key={j} className="matrixcell">{v}</td>)}</tr>)}</tbody></table></Card>}</div>}
 {tab==='explain'&&<div className="explainer"><TheoryStudio task={task} stage={stage} result={result}/><h3>Inside boosting round {stage+1}</h3><div className="metricgrid"><Metric name="estimator weight" value={active?.weight}/><Metric name="weighted estimator error" value={active?.error}/><Metric name={'staged test '+focus} value={active?.test[focus]}/><Metric name={'staged train '+focus} value={active?.train[focus]}/></div><p><b>Classification:</b> AdaBoost fits a weak classifier, measures its weighted error, and increases focus on previously misclassified training samples. The final decision combines weighted weak learners.</p><p><b>Regression:</b> AdaBoost.R2 uses normalized prediction errors to update sampling weights and combines regressors through a weighted median. Its estimator weights should not be interpreted with the classification SAMME error formula.</p><div className="formula">Binary / SAMME learner weight: α = learning_rate × ln((1 − error) / error)</div><p className="small">For multiclass SAMME, an extra ln(K−1) term applies. This mathematical panel is for intuition; implementation follows your installed scikit-learn version.</p></div>}
 {tab==='predictions'&&<div className="tablewrap"><table><thead><tr><th>Row ID</th><th>Actual</th><th>Predicted</th><th>Result</th></tr></thead><tbody>{result.predictions.map(r=><tr key={r.index}><td>{r.index}</td><td>{String(r.actual)}</td><td>{String(r.predicted)}</td><td>{r.correct==null?'—':r.correct?'Correct':'Incorrect'}</td></tr>)}</tbody></table></div>}</>}
 </Card></div>
 <section id="learning" className="learning"><TheoryStudio task={task} stage={stage} result={result}/><div className="eyebrow">UNDERSTAND THE ALGORITHM</div><h2>Boosting builds intelligence <em>one weak learner at a time.</em></h2><div className="learninggrid"><div><span>01</span><h3>Start small</h3><p>A shallow decision tree makes simple predictions. With depth 1, it is a decision stump.</p></div><div><span>02</span><h3>Focus on mistakes</h3><p>Adaptive weights emphasize samples or errors that the previous model struggled with.</p></div><div><span>03</span><h3>Combine carefully</h3><p>Weighted classification votes or a regression weighted median produce stronger predictions.</p></div></div></section><footer>modelmind / adaboost lab · Interactive research & education · No quiz required</footer></main></div>
}
